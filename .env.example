# Chave da API do TMDB (API Key v3 auth).
# NÃO tem prefixo VITE_ de propósito: ela é lida apenas no servidor
# (função serverless / proxy de dev) e nunca vai para o bundle do cliente.
#
# Local: copie este arquivo para .env e preencha a chave.
# Vercel: defina TMDB_API_KEY em Settings > Environment Variables.
TMDB_API_KEY=cole_sua_chave_aqui
